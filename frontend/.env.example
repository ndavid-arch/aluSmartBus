# Copy this file to .env and fill it in. Everything starting with VITE_ ends up in the website's
# JavaScript, where anyone can read it: never put a secret here.

# Where the backend lives once deployed. Leave it out locally: the dev server's /api proxy is used.
# VITE_API_URL=https://your-backend.example.com

# The map's background tiles (#40). Leave both out to use OpenStreetMap's volunteer servers.
# Pilot provider: Stadia Maps, free plan (non-commercial use only). It works on localhost with no
# key; once deployed, add the site's domain in the Stadia dashboard (no key in this file).
VITE_TILE_URL="https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png"
# Single quotes around the credit line, so the double quotes inside it are kept as they are
VITE_TILE_ATTRIBUTION='&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
